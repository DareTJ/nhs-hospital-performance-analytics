table Organisation
	lineageTag: 38a45365-6008-4c27-bfa0-4e50ed5be41e

	column provider_key
		dataType: string
		isHidden
		lineageTag: 510e407a-63d4-422d-b708-9f8f0a9fb172
		summarizeBy: none
		sourceColumn: provider_key

	column Provider
		dataType: string
		lineageTag: b91e0d6b-2432-4418-88e7-638201350d06
		summarizeBy: none
		sourceColumn: Provider

	column Code
		dataType: string
		lineageTag: 91d3867c-eb54-4fab-b3ce-4c12e707a2fe
		summarizeBy: none
		sourceColumn: Code

	column History
		dataType: string
		lineageTag: e5d5665d-a5a8-449f-8352-d6994b709d56
		summarizeBy: none
		sourceColumn: History

	column Name
		dataType: string
		lineageTag: 0cd47f09-d3d7-4669-9812-4f7cd6c4a7c7
		summarizeBy: none
		sourceColumn: Name

		annotation SummarizationSetBy = Automatic

	column Names
		dataType: int64
		formatString: 0
		lineageTag: b3494c45-6764-4415-9a2e-db8ac4e95155
		summarizeBy: none
		sourceColumn: Names

		annotation SummarizationSetBy = Automatic

	partition Organisation = m
		mode: import
		source =
				let
				    Rows = Table.SelectRows(Snapshot, each [org_code] <> "TOTAL"),
				    Groups = Table.Group(Rows, {"provider_key"}, {{"Latest", each Table.Max(_, "reporting_month"), type record}, {"Names", each List.Count(List.Distinct(List.Transform([org_name], Text.Upper))), Int64.Type}}),
				    Expanded = Table.ExpandRecordColumn(Groups, "Latest", {"org_code", "org_name"}, {"Code", "Name"}),
				    Labelled = Table.AddColumn(Expanded, "Provider", each [Name] & " (" & [provider_key] & ")", type text),
				    History = Table.AddColumn(Labelled, "History", each if List.Contains({"RA7", "RA7-PRE", "RVJ"}, [provider_key]) then "Bristol merger period" else if [Names] > 1 then "Name history review" else "No name variation detected", type text)
				in
				    History

